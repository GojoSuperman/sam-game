{
  "name": "sam-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPUM 월드 + SAM API 게임 셋업 — 프록시, bakedData 생성기, 연결 검증",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "game": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/sam-proxy.mjs",
    "test": "node scripts/test-case.mjs 2000 && node scripts/test-facts.mjs && node scripts/test-world.mjs 200 && node scripts/test-render.mjs && node scripts/test-playthrough.mjs 500 && node scripts/check-tiers.mjs && node scripts/check-assets.mjs && node scripts/test-map.mjs",
    "doctor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/doctor.mjs",
    "verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-sam.mjs",
    "verify-keys": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-keys.mjs",
    "proxy": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/sam-proxy.mjs",
    "bake": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bake-world.mjs",
    "map": "node scripts/make-map.mjs",
    "tiles": "node scripts/tile-picker.mjs",
    "tileset": "node scripts/make-tileset.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "import-tileset": "node scripts/import-tileset.mjs",
    "ai-source": "node scripts/make-ai-source.mjs",
    "asset-snippet": "node scripts/asset-snippet.mjs",
    "theme-from-backup": "node scripts/theme-from-backup.mjs",
    "fetch-theme": "node scripts/fetch-theme.mjs",
    "models": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/list-models.mjs",
    "check-tiers": "node scripts/check-tiers.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "fixtures": "node scripts/make-fixture-assets.mjs",
    "studio-login": "node scripts/studio-login.mjs",
    "studio-probe": "node scripts/studio-probe.mjs",
    "studio-sections": "node scripts/studio-probe-sections.mjs",
    "studio-assets": "node scripts/studio-assets.mjs",
    "studio-apply": "node scripts/studio-apply.mjs",
    "studio-open": "node scripts/studio-open.mjs",
    "studio-ai-theme": "node scripts/studio-ai-theme.mjs",
    "studio-restore": "node scripts/studio-restore.mjs",
    "scene-to-map": "node scripts/scene-to-map.mjs",
    "scene-map": "node scripts/make-scene-map.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
