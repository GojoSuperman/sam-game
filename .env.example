# ============================================================
#  sam-game 환경 변수 (예시 — 이 파일은 커밋된다)
# ------------------------------------------------------------
#  실제 값은 .env 또는 .env.local 에 넣는다. 이 파일에는 시크릿을 쓰지 않는다.
#  .env  -> 기본값
#  .env.local -> 개인/기기별 override (같은 키가 있으면 이쪽이 이긴다)
#  둘 다 있으면 둘 다 읽는다. 하나만 써도 된다.
# ============================================================

# --- 필수 ---
# sam.soonsoon.ai/api-keys 에서 Custom Key 발급 후 붙여넣기.
# 월 쌤 한도를 지정해서 발급하면 이 프로젝트 비용만 따로 볼 수 있다.
SAM_API_KEY=

# --- 프록시 ---
# 프록시 포트. SPUM 런타임에 알려줄 주소는
#   http://localhost:<PORT>/api/sam/v1/generate
PORT=8787

# 바인딩 주소. 기본 127.0.0.1(루프백 전용) — Windows 브라우저에서
# localhost 로 접근하는 데 충분하다. 0.0.0.0 으로 열려면
# SPUM_WORLD_ACCESS_TOKEN 도 반드시 지정해야 한다 (없으면 기동 거부).
# HOST=127.0.0.1

# 티어 프리셋 — SPUM 이 보내는 light/medium/expert 를 실제 SAM alias 로 변환.
#   balanced : light=glm-4.7-flash  medium=claude-haiku        expert=claude-sonnet-4.6
#   cheap    : light=glm-4.7-flash  medium=az-deepseek-v4-flash expert=az-deepseek-v4-pro
#   snappy   : light=gpt-5.4-nano   medium=az-deepseek-v4-flash expert=claude-haiku
# 매핑 검증: pnpm check-tiers
SAM_TIER_PRESET=balanced

# --- 선택 ---
# 프록시를 로컬(127.0.0.1) 밖으로 노출할 때만 설정한다.
# 설정하면 SPUM 런타임이 X-SPUM-WORLD-ACCESS 헤더로 이 값을 보내야 통과된다.
# web/spum-live-bootstrap.js 의 accessToken 에도 같은 값을 넣어야 한다.
# SPUM_WORLD_ACCESS_TOKEN=

# 브라우저에서 프록시를 호출할 오리진 허용 목록 (쉼표 구분).
# 미설정 시 기본값: https://spum.soonsoon.ai,http://localhost:8787,http://127.0.0.1:8787
# ALLOWED_ORIGINS=https://spum.soonsoon.ai,http://localhost:8787

# SAM 베이스 URL. 바꿀 일은 거의 없다.
# SAM_BASE_URL=https://sam.soonsoon.ai
